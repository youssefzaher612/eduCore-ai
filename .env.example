# ╔══════════════════════════════════════════════════════════════════╗
# ║                    EduCore Configuration                        ║
# ╚══════════════════════════════════════════════════════════════════╝

# === Database (PostgreSQL + pgvector) ===
DATABASE_URL=postgresql+asyncpg://educore:educore_pass@localhost:5432/educore
DATABASE_URL_SYNC=postgresql://educore:educore_pass@localhost:5432/educore

# === Local LLM provider (Ollama; no API key required) ===
AI_PROVIDER=ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3-vl:2b-instruct-q4_K_M
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct-q4_K_M
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=180
ASSESSMENT_GENERATION_MAX_CORRECTION_ATTEMPTS=1

# === Optional remote provider fallback (leave empty for fully local mode) ===
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=groq/llama-3.1-8b-instant
GROQ_FAST_MODEL=groq/llama-3.1-70b-versatile
GROQ_WEB_SEARCH_ENABLED=false
GOOGLE_API_KEY=
GOOGLE_VISION_MODEL=gemini-2.5-flash
VISION_MAX_UPLOAD_BYTES=12582912
VISION_MAX_COMPRESSED_BYTES=8388608
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_TEMPERATURE=0.15
OPENROUTER_ENABLE_WEB_SEARCH=false
# === Embedding Model (sentence-transformers, local) ===
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# === RAG Pipeline ===
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_CHUNK_CHARS=50
OCR_LANGUAGES=eng+ara
OCR_DPI=250
OCR_MAX_PAGES=20
# Optional: full path to tesseract.exe and its tessdata folder.
TESSERACT_CMD=
TESSDATA_DIR=./storage/tessdata
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.3

# === Celery (Background Processing) ===
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === Chat ===
CHAT_HISTORY_LIMIT=10

# === File Storage ===
STORAGE_DIR=./storage

# === FastAPI ===
API_HOST=0.0.0.0
API_PORT=8000


